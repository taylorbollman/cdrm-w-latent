    "reference_eager": true,
    "ordinary_attention_precision_policy": "legacy",
    "recurrent_precision_policy": "legacy",
    "recurrent_layers": null,
    "recurrent_backend": "tiled",
    "recurrent_write_rho": 1.0,
    "bwd_mlp_chunks": 4,
    "cdrm_enabled": false
