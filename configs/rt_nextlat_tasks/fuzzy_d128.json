  "window_layer": 0,
  "window_size": 2,
  "task_ranges": {"a5": [0, 60], "fuzzy": [60, 76]},
  "predictor_hidden_width": 128,
  "latent_weight": 1.0,
  "latent_transitions": "all within-example transitions, including native MAD padding",
  "evaluation": "backbone_only",
  "runtime": "fp32_eager"
}
